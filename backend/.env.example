# Example environment configuration for ThreatDock backend

## PostgreSQL database
# In Docker Compose these values are set automatically from docker-compose.yml.
# Keep the database files persistent on the host under ./data/postgres.
PGHOST=postgres
PGPORT=5432
PGDATABASE=threatdock
PGUSER=threatdock
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

## Redis (optional — enables Bull-backed job queue)
# Leave blank to use in-memory queue (default).
REDIS_URL=

## Connection Pool
# PostgreSQL pool max connections (default: 25)
PG_POOL_MAX=25
# Idle timeout in ms (default: 30000)
PG_IDLE_TIMEOUT_MS=30000

## Core API keys
# GitHub token (optional, improves GitHub Advisories API rate limiting)
GITHUB_TOKEN=

# NVD API key (optional, improves NVD API rate limiting)
NVD_API_KEY=

# AlienVault OTX API key (required to fetch subscribed pulses)
OTX_API_KEY=

# ThreatFox Auth-Key (required to fetch IOCs)
THREATFOX_AUTH_KEY=

# MISP instance URL and API key (enable integration with your MISP server)
MISP_URL=
MISP_API_KEY=

# IntelOwl API key (enable integration with IntelOwl when implemented)
INTELO_OWL_API_KEY=

## Digital Risk / Brand Monitoring APIs
# BreachDirectory on RapidAPI (credential exposure lookup)
BREACHDIRECTORY_RAPIDAPI_KEY=
BREACHDIRECTORY_RAPIDAPI_HOST=breachdirectory.p.rapidapi.com

# URLScan.io API key (brand/domain monitoring)
URLSCAN_API_KEY=

# VirusTotal API key (domain reputation)
VIRUSTOTAL_API_KEY=

# Intelligence X API key
INTELX_API_KEY=

# SecurityTrails API key (asset enrichment)
SECURITYTRAILS_API_KEY=

## Notification Channels (leave blank to disable individual channels)
# Slack webhook URL
SLACK_WEBHOOK_URL=

# n8n webhook URL
N8N_WEBHOOK_URL=

# Telegram bot token + chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Microsoft Teams webhook URL
TEAMS_WEBHOOK_URL=

# Minimum severity for notifications (Critical, High, Medium, Low)
# Only alerts with severity >= this threshold trigger notifications. Defaults to High.
NOTIFY_THRESHOLD=High

# JSON-based notification routing rules (advanced)
NOTIFICATION_RULES=[]

## Authentication settings
# REQUIRED: Set a strong password for the initial admin account.
# Application will refuse to start if this is not changed from the placeholder.
AUTH_USER=threatdock
AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

## OIDC / OAuth2 Settings
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
JWT_SECRET=

## Settings Encryption
# AES-256-GCM key for encrypting API keys in the database (auto-generated if empty)
SETTINGS_ENCRYPTION_KEY=

## Risk Scoring Weights (JSON)
RISK_WEIGHTS={"cvssCritical":30,"cvssHigh":22,"epssHigh":20,"epssMedium":10,"kev":30,"exploitSignal":15,"exposedService":10,"assetCriticality":15,"vendorRiskDivisor":5}

## DNS servers for impersonation detection
PUBLIC_DNS_SERVERS=1.1.1.1,8.8.8.8

## Monitored brands for automated brand exposure scanning (JSON array)
MONITORED_BRANDS=[]
