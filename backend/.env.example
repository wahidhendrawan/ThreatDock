# Example environment configuration for ThreatDock backend

## PostgreSQL database
# In Docker Compose these values are set automatically from docker-compose.yml.
# Keep the database files persistent on the host under ./data/postgres.
PGHOST=postgres
PGPORT=5432
PGDATABASE=threatdock
PGUSER=threatdock
PGPASSWORD=5V0Qb9ddoiO#%,oy

## Core API keys
# GitHub token (optional, improves GitHub Advisories API rate limiting)
GITHUB_TOKEN=

# NVD API key (optional, improves NVD API rate limiting)
NVD_API_KEY=

# AlienVault OTX API key (required to fetch subscribed pulses)
OTX_API_KEY=

# ThreatFox Auth-Key (required to fetch IOCs)
THREATFOX_AUTH_KEY=

# MISP instance URL and API key (enable integration with your MISP server)
MISP_URL=
MISP_API_KEY=

# IntelOwl API key (enable integration with IntelOwl when implemented)
INTELO_OWL_API_KEY=

# BreachDirectory on RapidAPI (credential exposure lookup)
BREACHDIRECTORY_RAPIDAPI_KEY=
BREACHDIRECTORY_RAPIDAPI_HOST=breachdirectory.p.rapidapi.com

# Slack webhook URL for sending alert notifications (leave blank to disable notifications)
SLACK_WEBHOOK_URL=

# Minimum severity for notifications (Critical, High, Medium, Low).  Only alerts with severity
# equal to or above this level will trigger a Slack message.  Defaults to High if not set.
NOTIFY_THRESHOLD=High

## Authentication settings
# If both AUTH_USER and AUTH_PASSWORD are set, HTTP Basic authentication will be
# required for all API requests to the backend.  Leave these blank to disable auth.
AUTH_USER=threatdock
AUTH_PASSWORD=5bR--ThCUr+GIo(k

# Additional variables can be added here for future integrations (e.g., YARA/Sigma services).
N8N_WEBHOOK_URL=

## OIDC / OAuth2 Settings
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Base URL Frontend
FRONTEND_URL=
JWT_SECRET=
